# GTAiVoiceCall — исходные данные и секреты для MVP1
#
# Как использовать:
# 1. Скопируйте этот файл в той же папке под именем `.env`.
# 2. Заполните поля, отмеченные «ОБЯЗАТЕЛЬНО».
# 3. Не присылайте заполненный файл в чат и не добавляйте его в Git.
# 4. Ограничьте доступ: chmod 600 .env
# 5. Когда файл готов, напишите в этом чате: старт
#
# Значения должны быть в одной строке. Если значение содержит пробелы или
# специальные символы shell, заключите его в одинарные кавычки.

# ── Контроль готовности ────────────────────────────────────────────────────
# После заполнения всех обязательных полей замените no на yes.
MVP_CONFIG_COMPLETE=no

# ── Репозиторий ────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО: будущий GitHub-репозиторий в формате owner/repository.
# Если его ещё нет, Codex создаст private-репозиторий после команды «старт».
GITHUB_REPOSITORY=
GITHUB_VISIBILITY=private

# Зафиксированная база MVP1. Эти значения менять не нужно.
UPSTREAM_REPOSITORY=https://github.com/kpshinnik/gpt_voice_pbx.git
UPSTREAM_SHA=22419d6e02b023d230b455446a5607143ddb4754

# ── OpenAI / GPT-Live ──────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО: существующий API key с доступом к gpt-live-1.
OPENAI_API_KEY=
LIVE_MODEL=gpt-live-1
LIVE_BACKEND_MODEL=gpt-5.6-terra
DEFAULT_VOICE=marin

# Необязательно: заполните только если ключ требует явного project/org.
OPENAI_PROJECT_ID=
OPENAI_ORG_ID=

# ── Сервер модели, вне РФ ──────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО: SSH alias из ~/.ssh/config или user@host.
# Нужны root либо passwordless sudo, Ubuntu 22.04/24.04 и доступ к OpenAI.
MODEL_SSH=

# ОБЯЗАТЕЛЬНО: yes, если сервер выделен под проект и установка Node/systemd
# сервисов в /srv допустима. Иначе укажите no и опишите ограничения ниже.
MODEL_SERVER_DEDICATED=
MODEL_SERVER_NOTES=

# Можно оставить пустым: адрес будет определён на сервере при старте.
MODEL_PUBLIC_IPV4=

# ── Сервер телефонии, РФ ───────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО: SSH alias из ~/.ssh/config или user@host.
# Нужны root либо passwordless sudo, Ubuntu 22.04/24.04 и публичный IP.
PBX_SSH=

# ОБЯЗАТЕЛЬНО: yes, если сервер выделен под GTAiVoiceCall.
PBX_SERVER_DEDICATED=

# ОБЯЗАТЕЛЬНО: укажите yes, только если на сервере можно установить Asterisk
# и заменить его конфиги. Перед изменением Codex всё равно сделает inventory
# и сохранит существующую конфигурацию для rollback.
PBX_ALLOW_ASTERISK_CONFIG_REPLACEMENT=

# ОБЯЗАТЕЛЬНО: yes, если Codex может настроить UFW для 22/80/443 и разрешить
# SIP/RTP только адресам Mango. Существующие посторонние правила сохраняются.
PBX_ALLOW_FIREWALL_CONFIGURATION=

# Опишите уже работающие на сервере сервисы, панели, reverse proxy или VPN.
PBX_SERVER_NOTES=

# Можно оставить пустым: адрес будет определён на сервере при старте.
PBX_PUBLIC_IPV4=

# ── Mango Office SIP ───────────────────────────────────────────────────────
# Для SIP-адреса user@mangosip.ru:
#   PBX_EXTENSION=user
#   PBX_DOMAIN=mangosip.ru
# Пароль сюда, в чат или Git не отправлять — только в локальный `.env`.
PBX_DOMAIN=mangosip.ru
PBX_EXTENSION=
PBX_SIP_PASSWORD=

# Mango поддерживает UDP 5060 и 60000. Начинаем с 5060; при необходимости
# диагностика регистрации определит правильный порт для вашей учётной записи.
PBX_SIP_PORT=5060
PBX_SIP_TRANSPORT=udp
PBX_REGISTRATION_EXPIRATION=180
PBX_CODEC=alaw
PBX_DTMF_MODE=rfc4733

# ОБЯЗАТЕЛЬНО: публичный номер Mango, который должен отображаться у абонента.
# Формат: 7XXXXXXXXXX, без пробелов, скобок и дефисов.
PBX_CALLER_ID=

# ОБЯЗАТЕЛЬНО: yes, если этому SIP-сотруднику разрешены исходящие звонки
# через указанный PBX_CALLER_ID в личном кабинете Mango.
MANGO_OUTBOUND_ENABLED=

# Для Mango обычно используется 7 + десять цифр.
DIAL_PREFIX=7
RING_TIMEOUT=45

# ── Защищённый bridge между серверами ──────────────────────────────────────
# ОБЯЗАТЕЛЬНО: DNS-имя с A-записью на публичный IPv4 PBX-сервера.
# Пример: voice-pbx.example.com
BRIDGE_DOMAIN=

# ОБЯЗАТЕЛЬНО: email для выпуска сертификата Let's Encrypt.
ADMIN_EMAIL=

# Можно оставить пустыми: Codex сгенерирует стойкие значения при старте.
BRIDGE_TOKEN=
ARI_USER=dialer
ARI_PASSWORD=

# Можно оставить пустым: будет собран из BRIDGE_DOMAIN.
BRIDGE_URL=

# Можно оставить пустым: будет установлен в публичные адреса model server.
BRIDGE_ALLOW=

# ── Первый реальный звонок ─────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО: только ваш тестовый номер. Это одновременно allowlist.
# Формат: 7XXXXXXXXXX. Несколько номеров пока не указывайте.
ALLOWED_NUMBERS=

# Имя владельца тестового номера для обращения во время звонка.
TEST_CALLEE_NAME=

# Коротко опишите цель тестового разговора.
# Пример: 'Проверить двусторонний звук, перебивание и завершение звонка.'
MVP_CALL_PURPOSE=

# Для первого прохода оставляем один одновременный звонок и запись выключаем.
MAX_CALLS=1
RECORD_CALLS=off

# Если включите запись, заранее подготовьте фразу уведомления собеседника.
CALL_RECORDING_NOTICE=

# ── Model server / операторский интерфейс ──────────────────────────────────
PORT=3000
HOST=127.0.0.1
SESSIONS_PER_IP_HOUR=20
SESSIONS_TOTAL_HOUR=120

# Оставьте пустым для доступа только через SSH tunnel.
ALLOWED_ORIGINS=

# ── Deployment policy ──────────────────────────────────────────────────────
# auto: настроить UFW при разрешении выше; skip: сеть настраивается отдельно.
FIREWALL=auto

# Никогда не ставьте здесь yes заранее. После реального звонка Codex выставит
# фактический итог в evidence-отчёте, а не в секретном файле.
MVP_ACCEPTANCE_CONFIRMED=no
