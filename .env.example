# ── OpenAI ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Модель бэкенда, которой gpt-live-1 делегирует факты и поиск
LIVE_BACKEND_MODEL=gpt-5.6-terra

# ── Серверы (SSH-адреса, user@host или alias из ~/.ssh/config) ─────────────
# Сервер модели — ВНЕ контура РФ (OpenAI не отвечает российским адресам)
MODEL_SSH=
# Сервер телефонии — ВНУТРИ контура РФ (российские АТС не пускают иностранные адреса)
PBX_SSH=

# ── АТС (любая SIP-АТС с внутренними номерами; проверено на onlinePBX) ─────
# Домен/адрес АТС, на котором регистрируется внутренний номер
PBX_DOMAIN=
# Внутренний номер, заведённый специально под робота, и его SIP-пароль
PBX_EXTENSION=
PBX_SIP_PASSWORD=
# Номер, который видит клиент (должен быть разрешён этому добавочному в правилах исходящих АТС)
PBX_CALLER_ID=
# Ключ API АТС — необязателен, только для чтения (список добавочных, история)
PBX_API_KEY=

# ── Мост сервер телефонии ↔ сервер модели ──────────────────────────────────
# Домен сервера телефонии с A-записью на его IP; сертификат выпустит deploy.sh
BRIDGE_DOMAIN=
# Почта для Let's Encrypt
ADMIN_EMAIL=
# Общий секрет моста: openssl rand -hex 24
BRIDGE_TOKEN=
# Адреса, с которых мост принимает сервер модели (через запятую, IPv4 и/или IPv6-префикс)
BRIDGE_ALLOW=
# Подставляется автоматически из BRIDGE_DOMAIN
# BRIDGE_URL=wss://pbx.example.com/pbx/bridge

# ── Звонки ─────────────────────────────────────────────────────────────────
# На какие номера можно звонить: none = только самопроверка test:sim1; список через запятую; пусто = любые
ALLOWED_NUMBERS=none
MAX_CALLS=2
# Формат набора: АТС получает DIAL_PREFIX + 10 цифр (onlinePBX: 7)
DIAL_PREFIX=7
# Писать все реальные звонки (on/off). Запись разговоров требует уведомления собеседника
RECORD_CALLS=off
# auto = deploy.sh настраивает ufw сам; skip = файрвол настраиваете вручную
FIREWALL=auto

# ── Веб-интерфейс ──────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
# Домены, с которых можно открывать браузерные сессии (если интерфейс публикуется)
# ALLOWED_ORIGINS=https://site.example.com
SESSIONS_PER_IP_HOUR=20
SESSIONS_TOTAL_HOUR=120
